# Everything a run depends on, pinned. Sourced by pod_setup.sh and the matrix scripts.
# ONT publishes no checksums and no official container image (dorado#1584), so the archive hashes below were
# computed here on 2026-11-06 from the CDN downloads, and pods run the Linux archive on a plain CUDA base image.

DORADO_VERSION=2.1.2
DORADO_LINUX_URL=https://cdn.oxfordnanoportal.com/software/analysis/dorado-2.1.2-linux-x64.tar.gz
DORADO_LINUX_SHA256=f4ed83acfb75cf07ffe8a0fc78e26828fc911fcfc8177920be6104e1d0e02485
DORADO_OSX_URL=https://cdn.oxfordnanoportal.com/software/analysis/dorado-2.1.2-osx-arm64.zip
DORADO_OSX_SHA256=6cdca387dbce5574d022d3759f1f5c4f8491a08877f051e3d3430b8402ef4780
# The Linux archive bundles CUDA 12.8 (libcudart 12.8.57, libcublas 12.8.3.14), so the driver must support 12.8.
# bin/dorado embeds SASS for sm_61..sm_120, including sm_120 (fatbin header scan, scripts/../logs/stage0).

# Base image for pods: no CUDA toolkit needed beyond the driver.
IMAGE="nvidia/cuda:12.8.1-base-ubuntu24.04@sha256:133c78a0575303be34164d0b90137a042172bdf60696af01a3c424ab402d86e2"

# Python tools on the pod and the laptop.
POD5_VERSION=0.3.49
PYSAM_VERSION=0.24.1

# Models (dorado download --list on 2.1.2). Mods are pinned to a version: --modified-bases always takes the latest.
M_HAC52=dna_r10.4.1_e8.2_400bps_hac@v5.2.0
M_SUP52=dna_r10.4.1_e8.2_400bps_sup@v5.2.0
M_HAC60=dna_r10.4.1_e8.2_400bps_hac@v6.0.0
M_HAC52_5MC5HMC=dna_r10.4.1_e8.2_400bps_hac@v5.2.0_5mC_5hmC@v2
M_SUP52_5MC5HMC=dna_r10.4.1_e8.2_400bps_sup@v5.2.0_5mC_5hmC@v2
M_HAC60_5MC5HMC=dna_r10.4.1_e8.2_400bps_hac@v6.0.0_5mC_5hmC@v1
# There is no DNA sup@v6.0.0 in 2.1.2.

# Per-CpG pileups (Q4). No macOS build; the laptop runs this Linux binary in Docker (linux/amd64).
MODKIT_VERSION=0.6.4
MODKIT_URL=https://github.com/nanoporetech/modkit/releases/download/v0.6.4/modkit_v0.6.4_u16_x86_64.tar.gz
MODKIT_SHA256=fb332c691431bd336eb0a81cbca17d2a35caf442ac48277ed3e296c2fe061d80

# The release dorado#1507's reporter crashed on (2026-03-23, 5mC_5hmC@v2), for the soak comparison only.
DORADO_1_4_0_LINUX_URL=https://cdn.oxfordnanoportal.com/software/analysis/dorado-1.4.0-linux-x64.tar.gz
DORADO_1_4_0_LINUX_SHA256=ea15250d911c6b6efdb21cc142008b2be8a5c781c8b0a4593b82f27b07385731
